# ============================================================
# EVENT PERSON IDENTITY SYSTEM
# GOOGLE DRIVE + ZERNIO
# ============================================================

# ============================================================
# RESULT DELIVERY
# ============================================================

# Enables:
# Process → Generate results → Upload to Drive → Send Zernio SMS
RESULT_DELIVERY_ENABLED=true


# ============================================================
# GOOGLE DRIVE
# ============================================================

# Enable or disable Google Drive integration
GOOGLE_DRIVE_ENABLED=true

# ------------------------------------------------------------
# Google OAuth credentials
# ------------------------------------------------------------

# OAuth client credentials downloaded from Google Cloud
GOOGLE_DRIVE_CREDENTIALS_PATH=credentials/credentials.json

# Generated automatically after the first Google authorization
GOOGLE_DRIVE_TOKEN_PATH=data/google_drive/token.json

# ------------------------------------------------------------
# Google Drive destination
# ------------------------------------------------------------

# Optional.
# Leave empty to use/create GOOGLE_DRIVE_FOLDER_NAME
# in the root of the user's Google Drive.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Root folder in Google Drive
GOOGLE_DRIVE_FOLDER_NAME=Event Results

# ------------------------------------------------------------
# Sharing
# ------------------------------------------------------------

# true  = anyone with the link can view the event folder
# false = do not automatically change Drive permissions
GOOGLE_DRIVE_PUBLIC_LINK=true

# ------------------------------------------------------------
# Upload settings
# ------------------------------------------------------------

# Number of retries for temporary API/network failures
GOOGLE_DRIVE_RETRY_COUNT=3

# HTTP timeout in seconds
GOOGLE_DRIVE_HTTP_TIMEOUT_SECONDS=60

GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_PUBLIC_LINK=true
